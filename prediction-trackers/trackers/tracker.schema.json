{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FOSTBeat prediction tracker specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "title", "status", "strapi", "question", "deadline", "resolution", "base_rate", "signals", "actors", "sources"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "title": { "type": "string", "minLength": 3 },
    "status": { "type": "string", "enum": ["draft", "active", "resolved-yes", "resolved-no"] },
    "needs_input": { "type": "array", "items": { "type": "string", "minLength": 3 } },
    "strapi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" }
      }
    },
    "question": { "type": "string", "minLength": 10 },
    "deadline": { "type": "string", "format": "date" },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yes", "no", "source"],
      "properties": {
        "yes": { "type": "string", "minLength": 10 },
        "no": { "type": "string", "minLength": 10 },
        "source": { "type": "string", "minLength": 3 }
      }
    },
    "base_rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p", "reasoning"],
      "properties": {
        "p": { "type": "number", "minimum": 0.01, "maximum": 0.99 },
        "reasoning": { "type": "string", "minLength": 10 }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "label", "weight"],
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 3 },
          "weight": { "type": "number", "minimum": 0, "maximum": 3 }
        }
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "stance", "influence"],
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "role": { "type": "string", "minLength": 2 },
          "stance": { "type": "integer", "minimum": -2, "maximum": 2 },
          "influence": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "queries": { "type": "array", "items": { "type": "string", "minLength": 3 } },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "source"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "source": { "type": "string", "format": "uri" },
        "note": { "type": "string" }
      }
    }
  }
}
